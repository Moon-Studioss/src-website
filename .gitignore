# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# NOTE: ignoring only stops NEW files. A file that is already tracked stays public
# until it is removed from git with `git rm --cached <file>`.

# ─── Secrets: never commit ──────────────────────────────────────────
.env*
!.env*.template
!.env*.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cert
*.secret
secrets/
credentials*.json
service-account*.json
.npmrc
.netrc

# ─── Private: client / business / security docs ─────────────────────
SECURITY_AUDIT.md
/SRC-work-plan.pdf
SRC - Website & Project Management System.pdf
/*.pdf
project-intake-design-brief.md
future-work/
docs/superpowers/

# ─── AI agent instructions, tools and their output ──────────────────
AGENTS.md
CLAUDE.md
.claude/
.mcp.json
.agents/
.gemini/
.cursor/
.superpowers/
.playwright-mcp/
graphify-out/

# ─── Database internals: generated migrations / snapshots / dumps ───
# (drizzle-kit output maps every table and column; the app never reads it at runtime,
#  and `npm run db:push` compares src/lib/db/schema.ts with the database directly)
/drizzle/
*.sql
*.dump
*.backup
*.bak

# ─── One-off / scratch scripts (may touch the database directly) ────
/check_db.ts
/fix_db.ts
/sync_categories.ts
/test-delete.ts
/add_overdue_timer.ts
*.scratch.*

# ─── Raw design assets (the site only serves files from /public) ────
/images/
/screenshots
/Pasted image*
/3dprint*.png

# ─── Dependencies ───────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Build output and caches ────────────────────────────────────────
/.next/
/out/
/build
/coverage
.vercel
*.tsbuildinfo
next-env.d.ts
.eslintcache
.turbo/

# ─── Logs and databases ─────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# ─── OS / editor junk ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
