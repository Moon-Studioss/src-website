# Copy to .env.local and fill in your own values. Never commit .env.local.

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin login and sessions
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me

# File uploads (Uploadthing)
UPLOADTHING_TOKEN=

# Scheduled clean-up job
CLEANUP_SECRET=replace-with-a-long-random-string

# Email notifications (optional)
RESEND_API_KEY=
EMAIL_FROM="Your Name <noreply@example.com>"
OWNER_EMAIL=

# Public values (visible in the browser; no secrets here)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=
